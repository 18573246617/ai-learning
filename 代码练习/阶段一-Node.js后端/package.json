{
    "name": "node-learning",
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.19.0",
    "scripts": {
        "dev:week1": "tsx watch src/week1/3-node学习-原生http.ts",
        "dev:week2": "tsx watch --env-file=env/.env.development src/week2/index.ts",
        "dev:week3": "tsx watch --env-file=env/.env.development src/week3/index.ts",
        "dev:week4": "tsx watch --env-file=env/.env.development src/week4/index.ts",
        "dev:week6": "tsx watch --env-file=env/.env.development src/week6/index.ts",
        "dev:week2-answer": "tsx watch 参考答案/week2/index.ts",
        "start:week2": "tsx src/week2/index.ts",
        "build:week2": "tsc -p tsconfig.build.json",
        "start:prod": "node dist/week2/index.js",
        "probe:week2": "tsx src/week2/probe.ts",
        "test": "vitest run",
        "check": "tsc --noEmit",
        "lint": "eslint src/week2",
        "format": "prettier --write src/week2",
        "format:check": "prettier --check src/week2"
    },
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "express": "^5.1.0",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "pino": "^10.3.1",
        "supertest": "^7.2.2",
        "vitest": "^4.1.11",
        "yaml": "^2.9.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^26.0.0",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "tsx": "^4.19.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.68.0"
    }
}
