# 复制本文件为 .env.development 并填入真实值（.env* 已加入 .gitignore，不会提交）

# 服务端口
PORT=1300

# JWT 签名密钥（必填）。生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# CORS 允许的前端来源，多个用英文逗号分隔；留空表示不限制
# （开发环境按你的前端实际端口填，如 5173 是 vite 默认端口）
CORS_ORIGINS=http://localhost:5173

# OpenAI API 密钥（可选：不填服务照常启动，调用 /llm/chatgpt 时才报错）
OPENAI_API_KEY=

# PostgreSQL 连接串（Prisma CLI 专用，见根目录 prisma.config.ts；app 运行本身不读它）
# 格式：postgresql://用户名:密码@主机:5432/数据库名
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_learning_prisma
